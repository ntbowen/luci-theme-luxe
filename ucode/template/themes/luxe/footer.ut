{%
    let binfo = (type(boardinfo) == 'object') ? boardinfo : {};
    let release = (type(binfo.release) == 'object') ? binfo.release : {};
    let distversion = release.description || release.distribution || "OpenWrt";
    let lucirevision = release.revision || "Unknown";
%}
	</div>
	<footer class="mobile-hide">
	<a href="https://github.com/openwrt/luci">Powered by LuCI ({{ lucirevision }})</a> / {{ distversion }}
	</footer>
	</div>
</div>

<script type="text/javascript">L.require('menu-luxe')</script>
<div id="tempcpu"></div>
<div id="cpuusage"></div>
</body>
</html>